#!/bin/bash

args=(
  --new-session
  --die-with-parent

  --unshare-all
  --hostname localhost

  --clearenv
  --setenv PATH "/usr/sbin:/usr/bin:$HOME/.local/share/mise/shims:/slack/dotfiles/bin"
  --setenv HOME "$HOME"
  --setenv TERM "$TERM"
  --setenv COLORTERM "$COLORTERM"
  --setenv EDITOR "$EDITOR"

  --ro-bind /bin /bin
  --ro-bind /usr /usr
  --symlink /usr/lib64 /lib64

  --ro-bind /etc/localtime /etc/localtime

  --ro-bind /slack/dotfiles /slack/dotfiles
  --ro-bind ~/.config/mise ~/.config/mise
  --ro-bind ~/.local/share/mise ~/.local/share/mise

  --dev-bind /dev/null /dev/null
  --dev-bind /dev/urandom /dev/urandom
  --tmpfs /run
  --tmpfs /tmp
  --proc /proc
)

for arg in "$@"; do
  case "$arg" in
    -p|--pwd)
      args+=( --chdir "$PWD" --bind "$PWD" "$PWD" )
      shift
      ;;
    -n|--net)
      args+=( --share-net )
      shift
      ;;
  esac
done

exec bwrap "${args[@]}" "$@"
